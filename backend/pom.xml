<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.felixhotel</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>backend</name>
	<description>Backend Felix Hotel</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!--
			Le versioni di Testcontainers non sono gestite dal parent di Spring Boot 4:
			senza il BOM importato sotto, le dipendenze dei test non risolvono la versione.
			2.0.5 e' la stessa che spring-boot-testcontainers 4.1.0 si porta dietro:
			allinearla evita di ritrovarsi due versioni diverse sullo stesso classpath.
		-->
		<testcontainers.version>2.0.5</testcontainers.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>${testcontainers.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Documentazione API: Swagger / OpenAPI (obbligatorio per convenzione di progetto) -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.1.0</version>
		</dependency>

		<!-- Richiesta dai DTO generati da openapi-generator-maven-plugin (contract-first, vedi build/plugins) -->
		<dependency>
			<groupId>org.openapitools</groupId>
			<artifactId>jackson-databind-nullable</artifactId>
			<version>0.2.6</version>
		</dependency>

		<!-- Generazione e validazione JWT: emettiamo e validiamo i token nella stessa app -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.13.0</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.13.0</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.13.0</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			Testcontainers: i test di integrazione girano contro un Postgres vero avviato
			in Docker, non contro un database in memoria. Motivo: lo schema lo possiede
			Flyway e Hibernate lo valida (ddl-auto=validate), quindi un H2 non
			verificherebbe niente di quello che gira davvero in produzione — e il DDL usa
			costrutti Postgres. Effetto collaterale voluto: ogni esecuzione dei test
			riapplica le migration da zero, quindi verifica anche quelle.
			Richiede Docker attivo sulla macchina.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- In Testcontainers 2.x i moduli hanno il prefisso "testcontainers-":
		     org.testcontainers:postgresql (nome 1.x) non esiste piu'. -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<!--
				Contract-first per DTO e rotte: sia i modelli di richiesta/risposta sia
				le interfacce dei Controller si definiscono nello spec OpenAPI
				(src/main/resources/openapi/felix-hotel-api.yaml) e si generano da li'
				a build-time, non si scrivono a mano. Regola di progetto: per
				aggiungere/modificare un DTO o un endpoint, si tocca prima lo YAML, poi
				si rigenera (mvn generate-sources). interfaceOnly=true: si genera solo
				l'interfaccia (niente stub @RestController), il Controller la implementa
				a mano secondo il pattern Controller -> Service.
			-->
			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<version>7.24.0</version>
				<executions>
					<execution>
						<id>generate-api</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/felix-hotel-api.yaml</inputSpec>
							<generatorName>spring</generatorName>
							<!-- Un solo spec => un solo package per i modelli e uno per le interfacce:
							     lo YAML copre tutto il dominio, non solo l'auth, e schemi trasversali come
							     ApiResponseBase/PageInfo non avrebbero senso sotto un package "auth". -->
							<modelPackage>com.felixhotel.backend.dto</modelPackage>
							<apiPackage>com.felixhotel.backend.api</apiPackage>
							<generateApis>true</generateApis>
							<generateApiTests>false</generateApiTests>
							<generateApiDocumentation>false</generateApiDocumentation>
							<generateModelTests>false</generateModelTests>
							<generateModelDocumentation>false</generateModelDocumentation>
							<!-- true solo per poter filtrare ApiUtil.java (vedi globalProperties): serve ai
							     default method di *Api per l'esempio JSON in Swagger UI, tutti gli altri
							     supporting file (Application.java, config, ecc.) restano esclusi dal filtro. -->
							<generateSupportingFiles>true</generateSupportingFiles>
							<generateMetadata>false</generateMetadata>
							<globalProperties>
								<supportingFiles>ApiUtil.java</supportingFiles>
							</globalProperties>
							<!--
								"format: time" non ha una mappatura predefinita nel generatore Java e
								uscirebbe come String, al contrario di "format: date" che diventa gia'
								LocalDate. La differenza non e' estetica: con una String, un orario
								scritto storto ("25:99") attraverserebbe la validazione del bordo e si
								romperebbe nel Service, cioe' arriverebbe al client come 500 invece che
								come 400 — esattamente il difetto che la regola 21 esiste per evitare.
								Mappandolo qui, a rifiutarlo e' Jackson prima ancora del Controller.
							-->
							<typeMappings>
								<typeMapping>time=LocalTime</typeMapping>
							</typeMappings>
							<importMappings>
								<importMapping>LocalTime=java.time.LocalTime</importMapping>
							</importMappings>
							<configOptions>
								<useSpringBoot3>true</useSpringBoot3>
								<useBeanValidation>true</useBeanValidation>
								<serializableModel>true</serializableModel>
								<interfaceOnly>true</interfaceOnly>
								<useTags>true</useTags>
								<documentationProvider>springdoc</documentationProvider>
							</configOptions>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!--
				Due stadi di test separati, di proposito:
				- surefire (`mvnw test`) esegue solo gli unitari (*Test): niente Spring,
				  niente Docker, pochi secondi. Devono poter girare ovunque, sempre.
				- failsafe (`mvnw verify`) esegue quelli di integrazione (*IT), che
				  avviano il contesto Spring e un Postgres in Testcontainers.
				Cosi' un test unitario non richiede Docker attivo, e in CI si possono
				tenere i due stadi distinti. La convenzione di nome non e' decorativa:
				e' cio' che decide quale plugin esegue cosa.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<!-- verify fa fallire la build se un IT e' fallito: senza questo goal
							     l'esito degli IT verrebbe registrato ma non bloccherebbe niente. -->
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!--
				JaCoCo: misura quanto codice i test esercitano davvero.
				Le due esecuzioni dell'agente servono perche' i test sono in due stadi:
				surefire per gli unitari, failsafe per gli IT in un JVM separato. Scrivono
				sullo stesso file (append e' il default), cosi' il report li somma invece
				di raccontare meta' storia ciascuno — e in questo progetto la meta' che
				conta e' quella degli IT, dove sta il peso (regola 16).
				Il report sta su post-integration-test e non su verify: e' la fase in cui
				i JVM dei test hanno gia' scritto i loro dati, senza dipendere dall'ordine
				in cui i plugin sono dichiarati.
			-->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.13</version>
				<configuration>
					<excludes>
						<!--
							Il codice generato non si misura: DTO e interfacce API nascono
							dallo YAML (regola 12) e non c'e' nessun test da scrivere per un
							getter che non abbiamo scritto noi. Contarlo vorrebbe dire che la
							copertura cala aggiungendo un campo allo spec.
						-->
						<exclude>com/felixhotel/backend/dto/**</exclude>
						<exclude>com/felixhotel/backend/api/**</exclude>
						<!-- Il main(): una riga, esercitata dall'avvio del contesto. -->
						<exclude>com/felixhotel/backend/BackendApplication.class</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>agente-unitari</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>agente-integrazione</id>
						<goals>
							<goal>prepare-agent-integration</goal>
						</goals>
						<configuration>
							<destFile>${project.build.directory}/jacoco.exec</destFile>
						</configuration>
					</execution>
					<execution>
						<id>report</id>
						<phase>post-integration-test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<!--
						La soglia. I numeri sono presi il 2026-08-25 misurando quel che
						c'era (95,5% istruzioni, 79,2% rami) e poi abbassati di qualche
						punto: una soglia messa esattamente al valore corrente fa fallire
						la build al primo metodo aggiunto senza il suo test, e la reazione
						normale a un cancello che suona sempre e' abbassarlo — cioe'
						toglierlo. Il margine serve a farlo suonare solo quando succede
						qualcosa di vero.
						I rami stanno piu' in basso delle istruzioni perche' sono la
						misura piu' severa e oggi la piu' debole: e' li' che si vede se un
						ramo d'errore e' stato scritto e mai esercitato.
						**Questi numeri salgono, non scendono.** Se la copertura cresce,
						si alza anche la soglia; se un branch la fa scendere sotto, si
						scrivono i test mancanti invece di allargare la maglia.
					-->
					<execution>
						<id>soglia</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>INSTRUCTION</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.90</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.75</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!--
				SpotBugs: legge il bytecode e cerca difetti veri (dereferenziazioni
				possibili di null, risorse non chiuse, equals/hashCode incoerenti), non
				questioni di stile. Analizza i soli sorgenti nostri: sul codice generato
				troverebbe cose che non possiamo correggere senza modificare a mano file
				sotto target/, cioe' esattamente quel che la regola 12 vieta.
			-->
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>4.9.8.1</version>
				<configuration>
					<effort>Max</effort>
					<threshold>Default</threshold>
					<includeTests>false</includeTests>
					<excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
					<!--
						Find Security Bugs: non e' un secondo strumento ma un pacchetto di
						rilevatori in piu' dentro quello che c'e' gia' — injection, crypto
						debole, segreti scritti nel codice, path traversal. Aggiunto il
						2026-08-25 perche' la sicurezza qui viene votata a ogni review e
						fino a quel giorno la giudicavano solo occhi umani, che sulle stesse
						quattrocento righe rilette tre volte smettono di vedere.
						Le sue segnalazioni ricadono sotto la stessa tolleranza zero: quelle
						che riguardano scelte deliberate stanno in spotbugs-exclude.xml, una
						per una e col motivo scritto accanto.
					-->
					<plugins>
						<plugin>
							<groupId>com.h3xstream.findsecbugs</groupId>
							<artifactId>findsecbugs-plugin</artifactId>
							<version>1.14.0</version>
						</plugin>
					</plugins>
				</configuration>
				<!--
					Tolleranza zero, e ci si puo' permettere di scriverlo perche' al
					momento di introdurlo i rilievi erano quattro e sono stati corretti
					tutti: si parte da zero, quindi "zero" e' una soglia che si puo'
					davvero mantenere. Un tetto tipo "al massimo N" avrebbe soltanto
					stabilito quanti difetti e' lecito lasciare in giro.
					Il goal e' `check` e non `spotbugs`: il secondo scrive il report e
					basta, il primo fa fallire la build. Un'analisi che non blocca niente
					e' una cartella dentro target/ che nessuno apre.
				-->
				<executions>
					<execution>
						<id>analisi</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!--
				Checkstyle: l'unico dei tre cancelli che guarda la **forma** del codice.
				SpotBugs cerca difetti e JaCoCo conta quanto e' esercitato: nessuno dei
				due si accorge di un file con i tab o di un import rimasto li' dopo un
				refactor. Il regolamento e' scritto su misura in checkstyle.xml — il
				perche' sta scritto in cima a quel file.
				Come gli altri due sta su `verify` e non in un passo del workflow: un
				controllo che vive solo in CI non esiste sulla macchina di chi scrive, lo
				si scopre dopo aver pushato e si impara a ignorarlo (regola 22).
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>3.6.0</version>
				<dependencies>
					<!--
						Il plugin si porta dietro una versione vecchia di Checkstyle: la si
						sovrascrive qui, altrimenti il regolamento andrebbe scritto contro un
						motore di anni fa.
					-->
					<dependency>
						<groupId>com.puppycrawl.tools</groupId>
						<artifactId>checkstyle</artifactId>
						<version>10.21.4</version>
					</dependency>
				</dependencies>
				<configuration>
					<configLocation>checkstyle.xml</configLocation>
					<!--
						Le cartelle sono elencate a mano invece di lasciare che il plugin
						prenda i source root del progetto: fra quelli c'e' anche
						target/generated-sources, dove vivono DTO e interfacce prodotti dallo
						YAML. Sono codice che la regola 12 vieta di modificare a mano, quindi
						segnalarne lo stile vorrebbe dire aprire rilievi che nessuno puo'
						chiudere — la stessa esclusione che hanno gia' JaCoCo e SpotBugs.
					-->
					<sourceDirectories>
						<sourceDirectory>${project.basedir}/src/main/java</sourceDirectory>
					</sourceDirectories>
					<!--
						Anche i test, che qui sono piu' codice del main ed e' dove sta il peso
						(regola 16). Una delle due righe troppo lunghe trovate alla misura
						stava proprio in un IT.
					-->
					<includeTestSourceDirectory>true</includeTestSourceDirectory>
					<testSourceDirectories>
						<testSourceDirectory>${project.basedir}/src/test/java</testSourceDirectory>
					</testSourceDirectories>
					<!--
						I rilievi si leggono nel log della build, non in un file dentro
						target/ che nessuno apre. E' gia' il default di questo goal, ed e'
						scritto lo stesso: e' la meta' che rende utile un cancello.
					-->
					<logViolationsToConsole>true</logViolationsToConsole>
					<failsOnError>true</failsOnError>
				</configuration>
				<executions>
					<execution>
						<id>stile</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
