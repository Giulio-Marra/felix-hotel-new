# Ferma la risalita: questo e' il progetto, non si eredita configurazione da
# cartelle superiori.
config.stopBubbling = true

# Marca con @lombok.Generated tutto cio' che Lombok scrive al posto nostro:
# getter, setter, costruttori, equals/hashCode.
#
# Serve a JaCoCo, che quell'annotazione la riconosce e salta i metodi che la
# portano. Senza, la copertura conterebbe decine di getter generati che nessun
# test chiama di proposito: il numero salirebbe o scenderebbe per motivi che non
# hanno niente a che vedere con quanto codice e' davvero esercitato, e una soglia
# costruita su quel numero misurerebbe la quantita' di @Getter invece della
# qualita' dei test.
lombok.addLombokGeneratedAnnotation = true
