# Copia questo file in .env (mai committato) e valorizza con i tuoi dati locali.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=felix_hotel
DB_USERNAME=postgres
DB_PASSWORD=changeme

JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRATION_MS=3600000

# Email. In sviluppo puntano a Mailpit, che raccoglie i messaggi invece di consegnarli:
#   docker run -d --name felix-mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit
# La webmail sta poi su http://localhost:8025. Con questi valori l'applicazione parte
# comunque anche senza Mailpit: un invio fallito finisce nel log e non blocca niente.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_MITTENTE=felix-hotel@example.com

# Indirizzo pubblico da cui l'applicazione si raggiunge: ci si costruiscono i link dentro
# le email. Il giorno che ci sara' il frontend, qui va il suo indirizzo e non questo.
APP_BASE_URL=http://localhost:8080
